# SongGeneration Studio - optional local configuration.
# Copy this file to `.env` (next to config.py) and edit. No secrets or
# machine-specific absolute paths should ever be committed.
#
# These map onto the SG_* environment variables read by config.py. The app
# runs fine with all defaults on a fresh install; only override what you need.

# --- 8GB VRAM profile ---
# Target VRAM in GB. <=8 auto-enables 4-bit quantization + 30s duration cap.
SG_TARGET_VRAM_GB=8
# audiolm quantization: 4 | 8 | off  (empty = auto)
SG_QUANTIZE=
# Max generated song duration in seconds (0 = model default).
SG_MAX_SONG_DURATION_SECONDS=30
# CPU layer offloading: 1 | 0
SG_FORCE_OFFLOAD=1

# --- Launcher ---
# Dry-run / setup-only / skip-setup flags (also usable from the BAT).
# SG_DRYRUN=1
# SG_SETUPONLY=1
# SG_SKIPSETUP=1
# Override the API port.
# SG_PORT=8080
# Override the PyTorch wheel index (e.g. cu118 for older Pascal drivers).
# SG_PYTORCH_INDEX=https://download.pytorch.org/whl/cu118

# --- Upload / export ---
# Max reference-audio upload size in MB.
SG_MAX_UPLOAD_MB=100
# Max seconds of reference audio considered for trimming.
SG_MAX_REFERENCE_SECONDS=10
# Hours to keep reference/trim temp files before cleanup.
SG_REFERENCE_TTL_HOURS=24

# --- Server ---
HOST=127.0.0.1
PORT=7860
# AI tool local settings
.claude/

# App folder (generated during install - everything is copied from root or downloaded)
app/

# OS files
.DS_Store
Thumbs.db
nul

# IDE
.idea/
.vscode/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/

